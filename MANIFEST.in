include 项目文档/README.md 项目文档/ORIGIN.md 项目文档/DEFENSIVE_SCOPE.md 项目文档/VALIDATION.md 项目文档/LICENSE 项目文档/NOTICE pyproject.toml requirements-build.txt
recursive-include tests *.py
recursive-include evidence *.json
recursive-include .github/workflows *.yml

include SOURCE_MANIFEST.json

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE NOTICE ORIGIN.md README.md VALIDATION.md
